{
  "name": "polyver",
  "version": "0.0.0",
  "description": "Compare package versions and evaluate VERS version ranges across ecosystems: npm, PyPI, Debian, RPM, Alpine, Maven and more. Zero dependencies.",
  "keywords": [
    "vers",
    "purl",
    "version",
    "version-range",
    "semver",
    "pep440",
    "debian",
    "rpm",
    "apk",
    "maven",
    "sbom",
    "cyclonedx",
    "vulnerability"
  ],
  "homepage": "https://github.com/ottramst/polyver#readme",
  "bugs": {
    "url": "https://github.com/ottramst/polyver/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ottramst/polyver.git"
  },
  "license": "MIT",
  "author": "Ott Ramst",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check . && tsc",
    "check:package": "publint && attw --pack . --profile esm-only",
    "oracle": "sh scripts/oracle/run.sh",
    "oracle:harvest": "sh scripts/oracle/harvest.sh",
    "prepublishOnly": "pnpm check && pnpm test && pnpm build && pnpm check:package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^22.20.5",
    "publint": "^0.3.25",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.15.0"
}
