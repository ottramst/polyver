# Container images used as version-comparison oracles, pinned by digest. After bumping one, rerun
# `pnpm oracle:harvest <eco>` and `pnpm oracle <eco>`, and update testdata/README.md.
DEB_IMAGE=debian:stable-slim@sha256:a717a33469731894e77e912ea7d714e27c2dc38ee6554fd1a3102e92999cfc66
RPM_IMAGE=fedora:latest@sha256:43b29f65a41eb9c35e1cd5323e3bdf3b655c2357a9f4f1ff2f9c2798e5045d80
APK_IMAGE=alpine:latest@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
# Maven has no container of its own: run.sh downloads maven-artifact from Maven Central, checks it
# against these SHA-256 sums and runs scripts/oracle/Oracle.java with it. MAVEN_ARTIFACT is the
# oracle; MAVEN_ARTIFACT_OLD only measures how Maven 3.9 differs (testdata/oracle/maven-3.9.txt).
MAVEN_IMAGE=eclipse-temurin:21-jdk@sha256:5d90b26c0784ccf55af55f97cbcf7f3969c66a06299c93bdc72649219942a48f
MAVEN_ARTIFACT=4.0.0-rc-7
MAVEN_ARTIFACT_SHA256=737daf46ee538938cc2f33332c950f2877f18265226eb1a92d52e09206f75905
MAVEN_ARTIFACT_OLD=3.9.16
MAVEN_ARTIFACT_OLD_SHA256=54cc1c1ef932e3d4a903352111b42b4d3c3ed8e7a1d0de73b625309d9c3ad3e8
# Go has an official image; run.sh runs scripts/oracle/golang/main.go there with golang.org/x/mod at
# the version in scripts/oracle/golang/go.mod, which `go` checks against go.sum. The image's Go must be
# at least the `go` line in that go.mod (x/mod v0.42.0 needs 1.26).
GOLANG_IMAGE=golang:1.27-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb
# Ruby's official image bundles RubyGems; run.sh runs scripts/oracle/gem.rb with it. `gem -v` names the
# RubyGems version, which the Ruby version determines (Ruby 4.0.9 bundles RubyGems 4.0.20).
GEM_IMAGE=ruby:4.0.9-alpine@sha256:d0c5befc0864d31c6219321c8d79de2941d1bc31c41505d9c9289c6192c36d60
# .NET has an official SDK image; run.sh builds scripts/oracle/nuget with it, restoring NuGet.Versioning
# at the version in Oracle.csproj, checked against the content hash in packages.lock.json.
NUGET_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0-alpine@sha256:cc02b814237a76c4735fb6eeee87181597b5e56f2ce458a435e527674d91f4d7
# Rust's official image runs scripts/oracle/cargo with the semver crate pinned by its Cargo.lock, built
# with --locked. The crate, not the toolchain, decides the results; run.sh names both in the header.
CARGO_IMAGE=rust:1.99.1-alpine@sha256:b1d5dd5a22a09404d3e798c0cf051b689077360374eb505fa5bb93c479693d87
# Composer's official image (PHP and Composer); run.sh installs composer/semver at COMPOSER_SEMVER from
# scripts/oracle/composer/composer.lock, cloning the locked commit (`preferred-install: source`), and
# runs scripts/oracle/composer/oracle.php, which checks the installed version.
COMPOSER_IMAGE=composer:2.10.3@sha256:b6dcd72ca98fa19d0e5b8476de179859704891fad06dd9e0b96833d4c430a5fc
COMPOSER_SEMVER=3.5.2
