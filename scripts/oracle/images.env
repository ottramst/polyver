# Container images used as version-comparison oracles, pinned by digest. After bumping one, rerun
# `pnpm oracle:harvest <eco>` and `pnpm oracle <eco>`, and update testdata/README.md.
DEB_IMAGE=debian:stable-slim@sha256:a717a33469731894e77e912ea7d714e27c2dc38ee6554fd1a3102e92999cfc66
RPM_IMAGE=fedora:latest@sha256:43b29f65a41eb9c35e1cd5323e3bdf3b655c2357a9f4f1ff2f9c2798e5045d80
APK_IMAGE=alpine:latest@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
# Maven has no container of its own: run.sh downloads maven-artifact from Maven Central, checks it
# against these SHA-256 sums and runs scripts/oracle/Oracle.java with it. MAVEN_ARTIFACT is the
# oracle; MAVEN_ARTIFACT_OLD only measures how Maven 3.9 differs (testdata/oracle/maven-3.9.txt).
MAVEN_IMAGE=eclipse-temurin:21-jdk@sha256:5d90b26c0784ccf55af55f97cbcf7f3969c66a06299c93bdc72649219942a48f
MAVEN_ARTIFACT=4.0.0-rc-7
MAVEN_ARTIFACT_SHA256=737daf46ee538938cc2f33332c950f2877f18265226eb1a92d52e09206f75905
MAVEN_ARTIFACT_OLD=3.9.16
MAVEN_ARTIFACT_OLD_SHA256=54cc1c1ef932e3d4a903352111b42b4d3c3ed8e7a1d0de73b625309d9c3ad3e8
# Go has an official image; run.sh runs scripts/oracle/golang/main.go there with golang.org/x/mod at
# the version in scripts/oracle/golang/go.mod, which `go` checks against go.sum.
GOLANG_IMAGE=golang:1.27-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb
